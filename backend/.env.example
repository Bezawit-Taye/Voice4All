# Voice4All Backend Configuration
# Copy this file to .env for local development. Render values are configured in its dashboard.
# IMPORTANT: Never commit .env or expose private API keys in frontend client code.

# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# Allowed CORS Origins (comma-separated; wildcard is development-only)
# Example: http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
CORS_ORIGIN=*

# Default Language for Tutor Responses: en (English) | am (Amharic)
DEFAULT_LANGUAGE=en

# AI Provider Selection
# Options:
#   - mock_demo    : Deterministic educational tutor with Amharic & English support (tested, recommended for evaluation)
#   - offline_faq  : Fast lookup matching predefined Q&A bank
#   - gemini       : Live Gemini curriculum tutor (requires an API key below)
#   - local_ai     : Local model server (e.g., Ollama or llama.cpp)
AI_PROVIDER=mock_demo

# Keep the Gemini key confidential and server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Local AI Model Endpoint
# ENABLE_LOCAL_AI=false
# LOCAL_MODEL_URL=http://localhost:11434/api/generate
# LOCAL_MODEL_NAME=llama3.2

# Edge TTS service URL (requires internet access; no API key)
TTS_SERVICE_URL=http://127.0.0.1:8001
# Set the same high-entropy secret in the Node and Python services for production.
TTS_SERVICE_TOKEN=

# Optional external integrations. Set only when enabling the corresponding feature.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@Voice4AllJobsBot
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

